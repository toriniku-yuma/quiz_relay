{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quiz-relay-federation-game-test",
  "main": "../../scripts/federation-game-worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "define": {
    "import.meta.env.DEV": "false"
  },
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/federation/v1/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Probe", "GameRoom", "Matchmaker"]
    }
  ],
  "env": {
    "a": {
      "name": "quiz-relay-federation-a-test",
      "vars": {
        "TEST_NODE": "A",
        "PROBES_ENABLED": "true",
        "ROOM_LIFECYCLE_LOGS": "true",
        "GAME_CONFIG_PROFILE": "default",
        "FEDERATION_ORIGIN": "https://quiz-relay-federation-a-test.quiz-relay.workers.dev",
        "PEER_ORIGIN": "https://quiz-relay-federation-b-test.quiz-relay.workers.dev",
        "SIGNING_KID": "federation-test-a-v1",
        "PEER_KID": "federation-test-b-v1"
      },
      "d1_databases": [
        {
          "binding": "GAME_D1",
          "database_name": "quiz-relay-federation-a-test",
          "database_id": "45f1cecf-0ffd-4b49-b668-553baba1ce55",
          "migrations_dir": "../../drizzle-d1"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PROBE",
            "class_name": "Probe"
          },
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          },
          {
            "name": "MATCHMAKER",
            "class_name": "Matchmaker"
          }
        ]
      },
      "services": [
        {
          "binding": "ACCOUNT_ERASURE",
          "service": "quiz-relay-federation-a-erasure-test"
        }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      },
      "ratelimits": [
        {
          "name": "API_LIMITER",
          "namespace_id": "716329411",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "FEDERATION_LIMITER",
          "namespace_id": "716329421",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "define": {
        "import.meta.env.DEV": "false"
      }
    },
    "b": {
      "name": "quiz-relay-federation-b-test",
      "vars": {
        "TEST_NODE": "B",
        "PROBES_ENABLED": "true",
        "ROOM_LIFECYCLE_LOGS": "true",
        "GAME_CONFIG_PROFILE": "default",
        "FEDERATION_ORIGIN": "https://quiz-relay-federation-b-test.quiz-relay.workers.dev",
        "PEER_ORIGIN": "https://quiz-relay-federation-a-test.quiz-relay.workers.dev",
        "SIGNING_KID": "federation-test-b-v1",
        "PEER_KID": "federation-test-a-v1"
      },
      "d1_databases": [
        {
          "binding": "GAME_D1",
          "database_name": "quiz-relay-federation-b-test",
          "database_id": "7ce4e9a2-1e52-48b9-a643-42642735db9d",
          "migrations_dir": "../../drizzle-d1"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PROBE",
            "class_name": "Probe"
          },
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          },
          {
            "name": "MATCHMAKER",
            "class_name": "Matchmaker"
          }
        ]
      },
      "services": [
        {
          "binding": "ACCOUNT_ERASURE",
          "service": "quiz-relay-federation-b-erasure-test"
        }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      },
      "ratelimits": [
        {
          "name": "API_LIMITER",
          "namespace_id": "716329412",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "FEDERATION_LIMITER",
          "namespace_id": "716329422",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "define": {
        "import.meta.env.DEV": "false"
      }
    }
  }
}
