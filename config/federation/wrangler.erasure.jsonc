{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quiz-relay-federation-erasure-test",
  "main": "../../src/erasure/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "env": {
    "a": {
      "name": "quiz-relay-federation-a-erasure-test",
      "vars": {
        "GAME_CONFIG_PROFILE": "default",
        "FEDERATION_ORIGIN": "https://quiz-relay-federation-a-test.quiz-relay.workers.dev",
        "SIGNING_KID": "federation-test-a-v1"
      },
      "d1_databases": [
        {
          "binding": "GAME_D1",
          "database_name": "quiz-relay-federation-a-test",
          "database_id": "45f1cecf-0ffd-4b49-b668-553baba1ce55",
          "migrations_dir": "../../drizzle-d1"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom",
            "script_name": "quiz-relay-federation-a-test"
          },
          {
            "name": "MATCHMAKER",
            "class_name": "Matchmaker",
            "script_name": "quiz-relay-federation-a-test"
          }
        ]
      }
    },
    "b": {
      "name": "quiz-relay-federation-b-erasure-test",
      "vars": {
        "GAME_CONFIG_PROFILE": "default",
        "FEDERATION_ORIGIN": "https://quiz-relay-federation-b-test.quiz-relay.workers.dev",
        "SIGNING_KID": "federation-test-b-v1"
      },
      "d1_databases": [
        {
          "binding": "GAME_D1",
          "database_name": "quiz-relay-federation-b-test",
          "database_id": "7ce4e9a2-1e52-48b9-a643-42642735db9d",
          "migrations_dir": "../../drizzle-d1"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom",
            "script_name": "quiz-relay-federation-b-test"
          },
          {
            "name": "MATCHMAKER",
            "class_name": "Matchmaker",
            "script_name": "quiz-relay-federation-b-test"
          }
        ]
      }
    }
  }
}
