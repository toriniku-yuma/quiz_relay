{
  "name": "quiz-relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.1"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars node_modules/vite/bin/vite.js --host 100.102.202.80 --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && node --experimental-vm-modules --test tests/federation-runtime.test.mjs && node scripts/check-vite-config.mjs && node scripts/check-game-catalog-seed.mjs && pnpm run build",
    "deploy": "pnpm run build && wrangler deploy",
    "probe": "node --env-file=.dev.vars scripts/probe.mjs",
    "federation:check:cloud": "node scripts/check-federation-cloud.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --error-on-warnings .",
    "config:apply": "node --env-file-if-exists=.dev.vars scripts/apply-game-config.ts",
    "config:apply:local": "pnpm run config:apply config/matchmaking.local.json local --apply",
    "db:local:setup": "node scripts/local-postgres.ts setup",
    "db:local:start": "node scripts/local-postgres.ts start",
    "db:local:stop": "node scripts/local-postgres.ts stop",
    "db:local:check": "node scripts/local-postgres.ts check",
    "db:generate": "drizzle-kit generate",
    "db:generate:d1": "drizzle-kit generate --config drizzle.d1.config.ts",
    "db:rehearse:d1": "node scripts/rehearse-d1-migration.ts --local",
    "auth:map:clerk": "node --env-file-if-exists=.env.postgres-local --env-file-if-exists=.dev.vars --env-file-if-exists=.env.supabase-admin scripts/map-clerk-accounts.ts",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "node scripts/migrate-d1.ts",
    "db:seed": "node scripts/game-catalog-seed.ts",
    "catalog:manage": "node --env-file-if-exists=.dev.vars scripts/manage-catalog.ts",
    "db:check": "node scripts/check-d1.mjs",
    "catalog:list": "node --env-file-if-exists=.dev.vars scripts/manage-catalog.ts --list",
    "maintenance:local": "node scripts/maintenance-local.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.23.0",
    "@clerk/clerk-js": "6.38.0",
    "@supabase/supabase-js": "2.116.0",
    "canonicalize": "4.0.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/vitest-plugin": "1.1.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch"
    }
  }
}
