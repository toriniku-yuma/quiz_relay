# Copy to .env.supabase-admin. CLI only: never put these in Worker bindings.
# Session pool / direct PostgreSQL connection with schema migration privileges.
GAME_MIGRATION_DATABASE_URL=
# quiz_game_config login: SELECT catalog, INSERT rules/competitions, update active profile.
GAME_CONFIG_DATABASE_URL=

# CLI only: quiz_game_catalog, limited to its registered owner.
GAME_CATALOG_DATABASE_URL=

# Organization foundation: enable only after migrations and cutover verification.
ORGANIZATION_ENABLED=false
# Dedicated quiz_organization connection; never reuse migration/catalog credentials.
ORGANIZATION_DATABASE_URL=
INITIAL_ADMIN_SUBJECT=
