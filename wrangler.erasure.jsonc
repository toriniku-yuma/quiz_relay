{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-relay-account-erasure",
  "main": "src/erasure/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "GAME_D1",
      "database_name": "quiz-relay-game",
      "database_id": "a4661202-0ad1-4a9e-b767-dc6464b38e24",
      "migrations_dir": "drizzle-d1"
    }
  ],
  "vars": { "GAME_CONFIG_PROFILE": "default" },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom",
        "script_name": "quiz-relay-probe"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker",
        "script_name": "quiz-relay-probe"
      }
    ]
  },
  "routes": []
}
