{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-relay-probe",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/federation/v1/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROBE", "class_name": "Probe" },
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Probe"] },
    { "tag": "v2", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["Matchmaker"] }
  ],
  "d1_databases": [
    {
      "binding": "GAME_D1",
      "database_name": "quiz-relay-game",
      "database_id": "a4661202-0ad1-4a9e-b767-dc6464b38e24",
      "migrations_dir": "drizzle-d1"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "services": [
    {
      "binding": "ACCOUNT_ERASURE",
      "service": "quiz-relay-account-erasure"
    }
  ],
  "vars": {
    "PROBES_ENABLED": "false",
    "GAME_OWNER": "https://quiz-relay-probe.quiz-relay.workers.dev",
    "GAME_CONFIG_PROFILE": "default"
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "716329410",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "FEDERATION_LIMITER",
      "namespace_id": "716329420",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
