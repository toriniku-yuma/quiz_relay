# Copy to .dev.vars. Generate a private random token; never commit it.
# D1 is bound in wrangler.jsonc. Apply its migrations locally before starting Vite.
PROBES_ENABLED=true
PROBE_TOKEN=
# Free Clerk Development application, Google only. See docs/guides/setup.md.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless session signature verification.
CLERK_JWT_KEY=

# Browser origin of the development server, such as http://127.0.0.1:5173 or the
# Tailscale Serve HTTPS origin. `pnpm probe` sends its requests to this origin.
PROBE_ORIGIN=

# Optional self-signed Vite HTTPS certificate and private key paths.
DEV_TLS_CERT=
DEV_TLS_KEY=

# Active settings profile. Version numbers are managed in D1.
GAME_CONFIG_PROFILE=local

# Clerk subject allowed to complete the first organization setup.
INITIAL_ADMIN_SUBJECT=
# Clerk subject of an organization administrator used by the local catalog CLIs.
CATALOG_SUBJECT=
